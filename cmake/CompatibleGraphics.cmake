# Patch build-private JUCE 8 modules only. Upstream sources stay untouched.
option(CHI_WINDOWS_SOFTWARE_GRAPHICS "Start Windows peers in GDI and store images in CPU memory" ON)
function(plate_compatible_graphics)
 if(WIN32 AND CHI_WINDOWS_SOFTWARE_GRAPHICS)
  get_target_property(module_root juce_gui_basics INTERFACE_JUCE_MODULE_PATH)
  set(private_root "${CMAKE_BINARY_DIR}/compatible-juce/modules")
  file(MAKE_DIRECTORY "${private_root}")
  foreach(module juce_graphics juce_gui_basics)
   file(COPY "${module_root}/${module}" DESTINATION "${private_root}")
  endforeach()
  set(peer "${private_root}/juce_gui_basics/native/juce_Windowing_windows.cpp")
  file(READ "${peer}" code)
  string(REPLACE "\r\n" "\n" code "${code}")
  set(expected "return new HWNDComponentPeer { *this, styleFlags, (HWND) parentHWND, false, 1 };")
  string(FIND "${code}" "${expected}" position)
  if(position EQUAL -1)
   message(FATAL_ERROR "CompatibleGraphics: unsupported JUCE Windows peer factory; audit the upstream code before updating this patch")
  endif()
  string(REPLACE "${expected}" "return new HWNDComponentPeer { *this, styleFlags, (HWND) parentHWND, false, 0 };" code "${code}")
  file(WRITE "${peer}" "${code}")
  set(image "${private_root}/juce_graphics/native/juce_Direct2DImage_windows.cpp")
  file(READ "${image}" code)
  string(REPLACE "\r\n" "\n" code "${code}")
  set(signature "ImagePixelData::Ptr NativeImageType::create (Image::PixelFormat format, int width, int height, bool clearImage) const\n{\n")
  string(FIND "${code}" "${signature}" start)
  if(start EQUAL -1)
   message(FATAL_ERROR "CompatibleGraphics: unsupported JUCE NativeImageType factory")
  endif()
  string(SUBSTRING "${code}" ${start} -1 tail)
  string(FIND "${tail}" "\n}" end)
  if(end EQUAL -1)
   message(FATAL_ERROR "CompatibleGraphics: NativeImageType factory terminator not found")
  endif()
  math(EXPR count "${end} + 2")
  string(SUBSTRING "${tail}" 0 ${count} old)
  string(REPLACE "${old}" "${signature}    return SoftwareImageType().create (format, width, height, clearImage);\n}" code "${code}")
  file(WRITE "${image}" "${code}")
  foreach(module juce_graphics juce_gui_basics)
   foreach(property INTERFACE_SOURCES INTERFACE_JUCE_MODULE_SOURCES INTERFACE_JUCE_MODULE_HEADERS)
    get_target_property(paths ${module} ${property})
    if(paths)
     string(REPLACE "${module_root}/${module}/" "${private_root}/${module}/" paths "${paths}")
     set_property(TARGET ${module} PROPERTY ${property} "${paths}")
    endif()
   endforeach()
   set_property(TARGET ${module} PROPERTY INTERFACE_JUCE_MODULE_PATH "${private_root}")
   target_include_directories(${module} BEFORE INTERFACE "${private_root}")
  endforeach()
  # Precedence also for dependents that include modules via audio_utils first.
  include_directories(BEFORE "${private_root}")
  set(policy "Windows: initial peer GDI (0); default images SoftwareImageType; Direct2D peer remains selectable.\n")
 else()
  set(policy "Upstream graphics factories (non-Windows or CHI_WINDOWS_SOFTWARE_GRAPHICS=OFF).\n")
 endif()
 file(WRITE "${CMAKE_BINARY_DIR}/compatible-graphics.txt" "${policy}")
endfunction()
